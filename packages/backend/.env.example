# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Set to the number of proxy hops (e.g. 1 behind nginx) so rate limits see real client IPs
TRUST_PROXY=

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farm_management
DB_USER=farm_admin
DB_PASSWORD=farm_password_dev
# Integration tests drop and recreate this database; the name must end in _test
TEST_DB_NAME=farm_management_test

# Auth
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10
BCRYPT_ROUNDS=12
# Login attempts per 15 minutes per IP + email
LOGIN_RATE_LIMIT=5
# Refresh cookie is Secure in production unless overridden (true/false)
COOKIE_SECURE=

# Frontend
CORS_ORIGIN=http://localhost:5173
# Base URL used to build password reset links
APP_URL=http://localhost:5173
