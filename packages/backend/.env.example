# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://farm_admin:farm_password_dev@localhost:5432/farm_management
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farm_management
DB_USER=farm_admin
DB_PASSWORD=farm_password_dev

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
